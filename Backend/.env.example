# MongoDB Atlas connection string (Atlas dashboard -> Database -> Connect -> "Connect your application")
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/roadride?retryWrites=true&w=majority

# Long random string used to sign admin login tokens. Any value works, just keep it secret.
JWT_SECRET=change-this-to-a-long-random-string

# Used once by `npm run seed` to create/update the single admin account.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password

# Frontend origin allowed to call this API (comma-separate multiple, e.g. local + production).
FRONTEND_ORIGIN=http://localhost:3000

PORT=4000